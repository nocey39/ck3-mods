# Alternate request-owned datamodels; the opposite model was empty while this one ran.
# A numeric item changing in place is not enough to recreate its widget.
widget = { name = "ama_runtime_stats_overlay" size = { 100% 100% } layer = middle alwaystransparent = yes
    visible = "[Not(IsObserver)]"
    vbox = { size = { 1 1 } alwaystransparent = yes
        datamodel = "[GetPlayer.MakeScope.GetList('ama_rt_requests_0')]"
        item = { widget = { name = "ama_rt_request" size = { 1 1 } alwaystransparent = yes
widget = { name = "ama_rt_request_1_0" size = { 1 1 } alwaystransparent = yes
    state = { name = "ama_rt_sample_1_0"
        trigger_when = "[GetMenAtArmsType('abudrar').IsValid]"
        alpha = 1
        duration = 0.1
        on_finish = "[GetScriptedGui('ama_rt_receive_1_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('ama_rt_damage', MakeScopeValue(GetMenAtArmsType('abudrar').GetStat(GetPlayer, GetNullProvince.Self, GetNullLandedTitle.Self, 'damage'))).AddScope('ama_rt_toughness', MakeScopeValue(GetMenAtArmsType('abudrar').GetStat(GetPlayer, GetNullProvince.Self, GetNullLandedTitle.Self, 'toughness'))).AddScope('ama_rt_pursuit', MakeScopeValue(GetMenAtArmsType('abudrar').GetStat(GetPlayer, GetNullProvince.Self, GetNullLandedTitle.Self, 'pursuit'))).AddScope('ama_rt_screen', MakeScopeValue(GetMenAtArmsType('abudrar').GetStat(GetPlayer, GetNullProvince.Self, GetNullLandedTitle.Self, 'screen'))).AddScope('ama_rt_siege', MakeScopeValue(GetMenAtArmsType('abudrar').GetStat(GetPlayer, GetNullProvince.Self, GetNullLandedTitle.Self, 'siege_value'))).AddScope('ama_rt_stack', MakeScopeValue(IntToFixedPoint(GetMenAtArmsType('abudrar').GetStackSize))).AddScope('ama_rt_ticket', MakeScopeValue(Scope.GetValue)).AddScope('ama_rt_reply_phase', MakeScopeValue(GetPlayer.MakeScope.Var('ama_rt_phase').GetValue)).End)]"
    }
}
widget = { name = "ama_rt_request_1_1" size = { 1 1 } alwaystransparent = yes
    state = { name = "ama_rt_missing_1_0"
        trigger_when = "[Not(GetMenAtArmsType('abudrar').IsValid)]"
        alpha = 1
        duration = 0.1
        on_finish = "[GetScriptedGui('ama_rt_receive_1_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('ama_rt_damage', MakeScopeValue('(CFixedPoint)0')).AddScope('ama_rt_toughness', MakeScopeValue('(CFixedPoint)0')).AddScope('ama_rt_pursuit', MakeScopeValue('(CFixedPoint)0')).AddScope('ama_rt_screen', MakeScopeValue('(CFixedPoint)0')).AddScope('ama_rt_siege', MakeScopeValue('(CFixedPoint)0')).AddScope('ama_rt_stack', MakeScopeValue('(CFixedPoint)1')).AddScope('ama_rt_ticket', MakeScopeValue(Scope.GetValue)).AddScope('ama_rt_reply_phase', MakeScopeValue(GetPlayer.MakeScope.Var('ama_rt_phase').GetValue)).End)]"
    }
}
