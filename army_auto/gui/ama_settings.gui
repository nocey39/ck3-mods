widget = { name = "ama_overlay" size = { 100% 100% } layer = middle
    visible = "[Not(IsObserver)]" ama_settings_panel = {}

    vbox = { size = { 1 1 } alwaystransparent = yes
        datamodel = "[GetPlayer.MakeScope.GetList('ama_acc_requests_0')]"
        item = { ama_acc_request_widget = {} }
    }
    vbox = { size = { 1 1 } alwaystransparent = yes
        datamodel = "[GetPlayer.MakeScope.GetList('ama_acc_requests_1')]"
        item = { ama_acc_request_widget = {} }
    }
    widget = { size = { 1 1 } alwaystransparent = yes
        state = { name = "ama_acc_failed_to_open"
            trigger_when = "[GetVariableSystem.Exists('ama_acc_auto_view')]"
            duration = 1.5
            on_finish = "[CloseGameView('accolade_view')]"
            on_finish = "[GetVariableSystem.Clear('ama_acc_auto_view')]"
        }
    }
    vbox = { size = { 1 1 } alwaystransparent = yes
        datamodel = "[GetPlayer.MakeScope.GetList('ama_size_requests_0')]"
        item = { ama_size_request = {} }
    }
    vbox = { size = { 1 1 } alwaystransparent = yes
        datamodel = "[GetPlayer.MakeScope.GetList('ama_size_requests_1')]"
        item = { ama_size_request = {} }
    }

    widget = { name = "ama_repl_host" size = { 1 1 } alwaystransparent = yes
        state = { name = "ama_repl_sample_0" trigger_when = "[And(And(GetPlayer.MakeScope.Var('ama_repl_pending').IsSet, EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('ama_repl_phase').GetValue, '(CFixedPoint)0')), GetPlayer.MakeScope.Var('ama_repl_new').Regiment.IsValid)]" duration = 0.1
            on_finish = "[GetScriptedGui('ama_repl_receive_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('ama_repl_object', GetPlayer.MakeScope.Var('ama_repl_new').Regiment.MakeScope).AddScope('ama_repl_current', MakeScopeValue(IntToFixedPoint(GetPlayer.MakeScope.Var('ama_repl_new').Regiment.GetMAAChunkCount))).AddScope('ama_repl_max', MakeScopeValue(IntToFixedPoint(GetPlayer.MakeScope.Var('ama_repl_new').Regiment.CalcMaxMAAChunkCount))).AddScope('ama_repl_reply_ticket', MakeScopeValue(GetPlayer.MakeScope.Var('ama_repl_ticket').GetValue)).End)]" }
        state = { name = "ama_repl_expire_0" trigger_when = "[And(GetPlayer.MakeScope.Var('ama_repl_pending').IsSet, EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('ama_repl_phase').GetValue, '(CFixedPoint)0'))]" duration = 2
            on_finish = "[GetScriptedGui('ama_repl_timeout_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('ama_repl_timeout_phase', MakeScopeValue('(CFixedPoint)0')).End)]" }
        state = { name = "ama_repl_sample_1" trigger_when = "[And(And(GetPlayer.MakeScope.Var('ama_repl_pending').IsSet, EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('ama_repl_phase').GetValue, '(CFixedPoint)1')), GetPlayer.MakeScope.Var('ama_repl_new').Regiment.IsValid)]" duration = 0.1
            on_finish = "[GetScriptedGui('ama_repl_receive_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('ama_repl_object', GetPlayer.MakeScope.Var('ama_repl_new').Regiment.MakeScope).AddScope('ama_repl_current', MakeScopeValue(IntToFixedPoint(GetPlayer.MakeScope.Var('ama_repl_new').Regiment.GetMAAChunkCount))).AddScope('ama_repl_max', MakeScopeValue(IntToFixedPoint(GetPlayer.MakeScope.Var('ama_repl_new').Regiment.CalcMaxMAAChunkCount))).AddScope('ama_repl_reply_ticket', MakeScopeValue(GetPlayer.MakeScope.Var('ama_repl_ticket').GetValue)).End)]" }
        state = { name = "ama_repl_expire_1" trigger_when = "[And(GetPlayer.MakeScope.Var('ama_repl_pending').IsSet, EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('ama_repl_phase').GetValue, '(CFixedPoint)1'))]" duration = 2
            on_finish = "[GetScriptedGui('ama_repl_timeout_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('ama_repl_timeout_phase', MakeScopeValue('(CFixedPoint)1')).End)]" }
    }

}
types ama_types {
    # Each request item owns the immutable ticket used by both callbacks.
    type ama_size_request = widget {
        size = { 1 1 } alwaystransparent = yes
        widget = { size = { 1 1 } alwaystransparent = yes
            state = { name = "ama_size_sample"
                trigger_when = "[GetPlayer.MakeScope.Var('ama_size_unit').Regiment.IsValid]"
                alpha = 1 duration = 0.2
                on_finish = "[GetScriptedGui('ama_size_receive_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('ama_size_object', GetPlayer.MakeScope.Var('ama_size_unit').Regiment.MakeScope).AddScope('ama_size_current', MakeScopeValue(IntToFixedPoint(GetPlayer.MakeScope.Var('ama_size_unit').Regiment.GetMAAChunkCount))).AddScope('ama_size_max', MakeScopeValue(IntToFixedPoint(GetPlayer.MakeScope.Var('ama_size_unit').Regiment.CalcMaxMAAChunkCount))).AddScope('ama_size_response_ticket', MakeScopeValue(Scope.GetValue)).End)]"
            }
        }
        widget = { size = { 1 1 } alwaystransparent = yes
            state = { name = "ama_size_expire"
                trigger_on_create = yes
                alpha = 1 duration = 2.5
                on_finish = "[GetScriptedGui('ama_size_timeout_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('ama_size_timeout_ticket', MakeScopeValue(Scope.GetValue)).End)]"
            }
        }
    }

    type ama_acc_request_widget = widget { size = { 1 1 } alwaystransparent = yes
        widget = { size = { 1 1 } alwaystransparent = yes
            state = { name = "ama_acc_add_attribute"
                trigger_when = "[And3(And(GetPlayer.MakeScope.Var('ama_acc_target').Accolade.IsValid, GetScriptedGui('ama_acc_complete_gui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('ama_acc_reply', GetPlayer.MakeScope.Var('ama_acc_target').Accolade.MakeScope).End)), EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('ama_acc_request').GetValue, '(CFixedPoint)1'), IsValidCommand(GetPlayer.MakeScope.Var('ama_acc_target').Accolade.MakeAddAccoladeTypeCommand(GetAccoladeType(Select_CString(GetPlayer.MakeScope.Var('ama_acc_target_type').IsSet, GetPlayer.MakeScope.Var('ama_acc_target_type').GetFlagKey, 'valiant_attribute')))))]"
                duration = 0.1
                on_finish = "[PostCommand(GetPlayer.MakeScope.Var('ama_acc_target').Accolade.MakeAddAccoladeTypeCommand(GetAccoladeType(Select_CString(GetPlayer.MakeScope.Var('ama_acc_target_type').IsSet, GetPlayer.MakeScope.Var('ama_acc_target_type').GetFlagKey, 'valiant_attribute'))))]"
                on_finish = "[GetScriptedGui('ama_acc_complete_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('ama_acc_reply', GetPlayer.MakeScope.Var('ama_acc_target').Accolade.MakeScope).End)]"
            }
        }
        widget = { size = { 1 1 } alwaystransparent = yes
            state = { name = "ama_acc_open_view"
                trigger_when = "[And3(And(GetPlayer.MakeScope.Var('ama_acc_target').Accolade.IsValid, GetScriptedGui('ama_acc_complete_gui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('ama_acc_reply', GetPlayer.MakeScope.Var('ama_acc_target').Accolade.MakeScope).End)), EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('ama_acc_request').GetValue, '(CFixedPoint)2'), And(Not(GetVariableSystem.Exists('ama_acc_auto_view')), Not(GetVariableSystem.Exists('ama_acc_silent_view'))))]"
                duration = 0.1
                on_finish = "[GetVariableSystem.Set('ama_acc_silent_view', 'true')]"
                on_finish = "[GetVariableSystem.Set('ama_acc_auto_view', 'true')]"
                on_finish = "[OpenGameViewData('accolade_view', GetPlayer.MakeScope.Var('ama_acc_target').Accolade.GetID)]"
            }
        }
    }
    type ama_acc_catalog_option = button_standard {
        size = { 162 32 }
        datacontext = "[GetAccoladeType(Scope.GetFlagKey)]"
        text = "[AccoladeType.GetNameNoTooltip]"
        tooltip = "ama_acc_attribute_tt"
        enabled = "[GetScriptedGui('ama_acc_pick_gui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('ama_choice', MakeScopeFlag(Scope.GetFlagKey)).End)]"
        onclick = "[GetScriptedGui('ama_acc_pick_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('ama_choice', MakeScopeFlag(Scope.GetFlagKey)).End)]"
        tooltip_when_disabled = "ama_acc_attribute_blocked_tt"
    }
    type ama_acc_assigned_option = button_standard {
        size = { 162 32 }
        datacontext = "[GetAccoladeType(Scope.GetFlagKey)]"
        text = "[AccoladeType.GetNameNoTooltip]"
        tooltip = "ama_acc_attribute_tt"
        enabled = no
        tooltip_when_disabled = "ama_acc_attribute_tt"
    }
    type ama_checkbox = button_checkbox_label {
        onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
        enabled = "[ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
        blockoverride "checkbox" { checked = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
    }
    type ama_option = button_standard {
        blockoverride "button_standard_current" { visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
    }
    type ama_settings_panel = widget {
        name = "ama_settings_panel" parentanchor = center size = { 640 760 } layer = middle
        filter_mouse = all alwaystransparent = no
        datacontext = "[GetPlayer]" datacontext = "[GetScriptedGui('ama_panel_gui')]"
        visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
        using = Window_Background using = Window_Decoration
        text_single = { position = { 92 20 } size = { 456 34 }
            autoresize = no align = center|vcenter text = "ama_panel_title" fontsize = 26 default_format = "#high" tooltip = "ama_notes" }
        button_close = { name = "ama_close" position = { 558 24 } size = { 32 32 }
            shortcut = "close_window" tooltip = "CLOSE_TOOLTIP"
            onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
        widget = { name = "ama_fixed_overview" position = { 48 68 } size = { 504 136 }
            background = { using = Background_Area alpha = 0.35 }
            text_single = { position = { 12 4 } size = { 88 34 }
                autoresize = no align = left|vcenter text = "ama_personal_row_label" fontsize = 16 tooltip = "ama_personal_row_help" }
            ama_checkbox = { name = "ama_create_enable" position = { 112 4 } size = { 100 34 }
                datacontext = "[GetScriptedGui('ama_create_toggle_gui')]" tooltip = "ama_create_help"
                blockoverride "text" { text = "ama_create_label" fontsize = 16 } }
            ama_checkbox = { name = "ama_expand_enable" position = { 224 4 } size = { 100 34 }
                datacontext = "[GetScriptedGui('ama_expand_toggle_gui')]" tooltip = "ama_expand_help"
                blockoverride "text" { text = "ama_expand_label" fontsize = 16 } }
            button_primary = { name = "ama_check_gui_button" position = { 348 4 } size = { 144 36 }
                datacontext = "[GetScriptedGui('ama_check_gui')]" text = "ama_check_now" tooltip = "ama_check_help"
                onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                enabled = "[ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                buttonText = { text_single = { size = { 100% 100% } autoresize = no margin = { 8 0 }
                        align = center|nobaseline fontsize = 16 default_format = "#clickable" alwaystransparent = yes } }
            }
            widget = { name = "ama_title_modes_row" position = { 0 42 } size = { 504 34 }
                datacontext = "[GetScriptedGui('ama_titles_available_gui')]"
                visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                text_single = { position = { 12 0 } size = { 88 34 }
                    autoresize = no align = left|vcenter text = "ama_title_row_label" fontsize = 16 tooltip = "ama_titles_help" }
                ama_checkbox = { name = "ama_title_create_enable" position = { 112 0 } size = { 100 34 }
                    datacontext = "[GetScriptedGui('ama_title_create_toggle_gui')]" tooltip = "ama_title_create_help"
                    blockoverride "text" { text = "ama_title_create_label" fontsize = 16 } }
                ama_checkbox = { name = "ama_title_expand_enable" position = { 224 0 } size = { 100 34 }
                    datacontext = "[GetScriptedGui('ama_title_expand_toggle_gui')]" tooltip = "ama_title_expand_help"
                    blockoverride "text" { text = "ama_title_expand_label" fontsize = 16 } }
            }
            text_multi = { position = { 12 82 } size = { 480 48 } max_width = 480
                autoresize = no align = left text = "ama_status_display" fontsize = 16 tooltip = "ama_status_help" }
        }
        widget = { name = "ama_acc_picker_page" position = { 48 216 } size = { 544 518 }
            visible = "[GetPlayer.MakeScope.Var('ama_acc_picker').IsSet]"
            text_single = { size = { 218 34 } autoresize = no align = left|vcenter
                text = "ama_acc_picker_title" fontsize = 18 default_format = "#high" }
            button_standard = { name = "ama_acc_clear_choice" position = { 226 0 } size = { 135 34 } text = "ama_acc_none"
                onclick = "[GetScriptedGui('ama_acc_clear_pick_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
            }
            button_standard = { name = "ama_acc_picker_back" position = { 370 0 } size = { 134 34 } text = "BACK_LABEL"
                onclick = "[GetScriptedGui('ama_acc_cancel_pick_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
            }
            scrollbox = { name = "ama_acc_catalog_scroll" position = { 0 45 } size = { 544 473 }
                blockoverride "scrollbox_margins" { margin_top = 0 margin_bottom = 0 margin_left = 0 margin_right = 0 }
                blockoverride "scrollbox_background" {}
                blockoverride "scrollbox_background_fade" {}
                blockoverride "scrollbox_content" {
                    vbox = { minimumsize = { 504 0 } layoutpolicy_vertical = preferred ignoreinvisible = yes spacing = 12
                        vbox = { name = "ama_acc_group_assigned" minimumsize = { 504 0 }
                            layoutpolicy_vertical = preferred spacing = 4
                            visible = "[DataModelHasItems(GetPlayer.MakeScope.GetList('ama_acc_options_assigned'))]"
                            text_single = { size = { 504 26 } autoresize = no align = left|vcenter
                                text = "ama_acc_group_assigned" fontsize = 16 default_format = "#high" }
                            fixedgridbox = { name = "ama_acc_choices_assigned" layoutpolicy_horizontal = expanding
                                flipdirection = yes datamodel_wrap = 3 addcolumn = 168 addrow = 34
                                datamodel = "[GetPlayer.MakeScope.GetList('ama_acc_options_assigned')]"
                                item = { ama_acc_assigned_option = {} }
                            }
                        }
                        vbox = { name = "ama_acc_group_common" minimumsize = { 504 0 }
                            layoutpolicy_vertical = preferred spacing = 4
                            visible = "[DataModelHasItems(GetPlayer.MakeScope.GetList('ama_acc_options_common'))]"
                            text_single = { size = { 504 26 } autoresize = no align = left|vcenter
                                text = "ama_acc_group_common" fontsize = 16 default_format = "#high" }
                            fixedgridbox = { name = "ama_acc_choices_common" layoutpolicy_horizontal = expanding
                                flipdirection = yes datamodel_wrap = 3 addcolumn = 168 addrow = 34
                                datamodel = "[GetPlayer.MakeScope.GetList('ama_acc_options_common')]"
                                item = { ama_acc_catalog_option = {} }
                            }
                        }
                        vbox = { name = "ama_acc_group_skilled" minimumsize = { 504 0 }
                            layoutpolicy_vertical = preferred spacing = 4
                            visible = "[DataModelHasItems(GetPlayer.MakeScope.GetList('ama_acc_options_skilled'))]"
                            text_single = { size = { 504 26 } autoresize = no align = left|vcenter
                                text = "ama_acc_group_skilled" fontsize = 16 default_format = "#high" }
                            fixedgridbox = { name = "ama_acc_choices_skilled" layoutpolicy_horizontal = expanding
                                flipdirection = yes datamodel_wrap = 3 addcolumn = 168 addrow = 34
                                datamodel = "[GetPlayer.MakeScope.GetList('ama_acc_options_skilled')]"
                                item = { ama_acc_catalog_option = {} }
                            }
                        }
                        vbox = { name = "ama_acc_group_maa" minimumsize = { 504 0 }
                            layoutpolicy_vertical = preferred spacing = 4
                            visible = "[DataModelHasItems(GetPlayer.MakeScope.GetList('ama_acc_options_maa'))]"
                            text_single = { size = { 504 26 } autoresize = no align = left|vcenter
                                text = "ama_acc_group_maa" fontsize = 16 default_format = "#high" }
                            fixedgridbox = { name = "ama_acc_choices_maa" layoutpolicy_horizontal = expanding
                                flipdirection = yes datamodel_wrap = 3 addcolumn = 168 addrow = 34
                                datamodel = "[GetPlayer.MakeScope.GetList('ama_acc_options_maa')]"
                                item = { ama_acc_catalog_option = {} }
                            }
                        }
                        vbox = { name = "ama_acc_group_eminent" minimumsize = { 504 0 }
                            layoutpolicy_vertical = preferred spacing = 4
                            visible = "[DataModelHasItems(GetPlayer.MakeScope.GetList('ama_acc_options_eminent'))]"
                            text_single = { size = { 504 26 } autoresize = no align = left|vcenter
                                text = "ama_acc_group_eminent" fontsize = 16 default_format = "#high" }
                            fixedgridbox = { name = "ama_acc_choices_eminent" layoutpolicy_horizontal = expanding
                                flipdirection = yes datamodel_wrap = 3 addcolumn = 168 addrow = 34
                                datamodel = "[GetPlayer.MakeScope.GetList('ama_acc_options_eminent')]"
                                item = { ama_acc_catalog_option = {} }
                            }
                        }
                    }
                }
            }
        }
        scrollbox = { name = "ama_settings_scroll" position = { 48 216 } size = { 544 518 }
            visible = "[Not(GetPlayer.MakeScope.Var('ama_acc_picker').IsSet)]"
            blockoverride "scrollbox_margins" { margin_top = 0 margin_bottom = 0 margin_left = 0 margin_right = 0 }
            blockoverride "scrollbox_background" {} blockoverride "scrollbox_background_fade" {}
            blockoverride "scrollbox_content" {
                vbox = { name = "ama_settings_body" minimumsize = { 504 0 }
                    layoutpolicy_vertical = preferred ignoreinvisible = yes spacing = 12

                    widget = { name = "ama_acc_heading" size = { 504 34 }
                        visible = "[GetScriptedGui('ama_acc_tab_gui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                        button_standard = { size = { 504 34 }
                            text = "[SelectLocalization(GetScriptedGui('ama_acc_tab_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), 'ama_acc_open', 'ama_acc_closed')]"
                            onclick = "[GetScriptedGui('ama_acc_tab_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                        }
                    }
                    vbox = { name = "ama_acc_settings" minimumsize = { 504 0 } spacing = 5
                        layoutpolicy_vertical = preferred ignoreinvisible = yes
                        visible = "[And(GetScriptedGui('ama_acc_tab_gui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End), GetScriptedGui('ama_acc_tab_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
                        widget = { size = { 504 38 }
                            ama_checkbox = { position = { 4 1 } size = { 224 36 }
                                datacontext = "[GetScriptedGui('ama_acc_toggle_gui')]"
                                tooltip = "ama_acc_help"
                                blockoverride "text" { text = "ama_acc_enable" fontsize = 16 }
                            }
                            button_standard = { position = { 344 1 } size = { 160 36 } text = "ama_acc_check" tooltip = "ama_acc_check_tt"
                                enabled = "[GetScriptedGui('ama_acc_check_gui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                                onclick = "[GetScriptedGui('ama_acc_check_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                            }
                        }
                        text_multi = { size = { 504 43 } max_width = 504 text = "ama_acc_help"
                            align = left fontsize = 15 autoresize = no }

                        widget = { name = "ama_acc_row_1" size = { 504 34 }
                            text_single = { position = { 0 0 } size = { 24 34 } raw_text = "1" align = center|vcenter }
                            button_standard = { position = { 30 0 } size = { 153 34 }
                                text = "[Localize(Select_CString(GetPlayer.MakeScope.Var('ama_acc_first_1').IsSet, GetPlayer.MakeScope.Var('ama_acc_first_1').GetFlagKey, 'ama_acc_first'))]"
                                onclick = "[GetScriptedGui('ama_acc_edit_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('ama_column', MakeScopeValue('(CFixedPoint)1')).End)]"
                                down = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('ama_acc_picker').GetValueWithDefault('(CFixedPoint)0'), '(CFixedPoint)1')]"
                            }
                            button_standard = { position = { 190 0 } size = { 153 34 }
                                text = "[Localize(Select_CString(GetPlayer.MakeScope.Var('ama_acc_second_1').IsSet, GetPlayer.MakeScope.Var('ama_acc_second_1').GetFlagKey, 'ama_acc_second'))]"
                                onclick = "[GetScriptedGui('ama_acc_edit_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('ama_column', MakeScopeValue('(CFixedPoint)6')).End)]"
                                down = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('ama_acc_picker').GetValueWithDefault('(CFixedPoint)0'), '(CFixedPoint)6')]"
                            }
                            text_single = { position = { 352 0 } size = { 152 34 }
                                text = "[Localize(Concatenate('ama_acc_state_', IntToString(FixedPointToInt(GetPlayer.MakeScope.Var('ama_acc_state_1').GetValueWithDefault('(CFixedPoint)0')))))]"
                                align = center|vcenter fontsize = 14 autoresize = no }
                        }

                        widget = { name = "ama_acc_row_2" size = { 504 34 }
                            text_single = { position = { 0 0 } size = { 24 34 } raw_text = "2" align = center|vcenter }
                            button_standard = { position = { 30 0 } size = { 153 34 }
                                text = "[Localize(Select_CString(GetPlayer.MakeScope.Var('ama_acc_first_2').IsSet, GetPlayer.MakeScope.Var('ama_acc_first_2').GetFlagKey, 'ama_acc_first'))]"
                                onclick = "[GetScriptedGui('ama_acc_edit_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('ama_column', MakeScopeValue('(CFixedPoint)2')).End)]"
                                down = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('ama_acc_picker').GetValueWithDefault('(CFixedPoint)0'), '(CFixedPoint)2')]"
                            }
                            button_standard = { position = { 190 0 } size = { 153 34 }
                                text = "[Localize(Select_CString(GetPlayer.MakeScope.Var('ama_acc_second_2').IsSet, GetPlayer.MakeScope.Var('ama_acc_second_2').GetFlagKey, 'ama_acc_second'))]"
                                onclick = "[GetScriptedGui('ama_acc_edit_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('ama_column', MakeScopeValue('(CFixedPoint)7')).End)]"
                                down = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('ama_acc_picker').GetValueWithDefault('(CFixedPoint)0'), '(CFixedPoint)7')]"
                            }
                            text_single = { position = { 352 0 } size = { 152 34 }
                                text = "[Localize(Concatenate('ama_acc_state_', IntToString(FixedPointToInt(GetPlayer.MakeScope.Var('ama_acc_state_2').GetValueWithDefault('(CFixedPoint)0')))))]"
                                align = center|vcenter fontsize = 14 autoresize = no }
                        }

                        widget = { name = "ama_acc_row_3" size = { 504 34 }
                            text_single = { position = { 0 0 } size = { 24 34 } raw_text = "3" align = center|vcenter }
                            button_standard = { position = { 30 0 } size = { 153 34 }
                                text = "[Localize(Select_CString(GetPlayer.MakeScope.Var('ama_acc_first_3').IsSet, GetPlayer.MakeScope.Var('ama_acc_first_3').GetFlagKey, 'ama_acc_first'))]"
                                onclick = "[GetScriptedGui('ama_acc_edit_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('ama_column', MakeScopeValue('(CFixedPoint)3')).End)]"
                                down = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('ama_acc_picker').GetValueWithDefault('(CFixedPoint)0'), '(CFixedPoint)3')]"
                            }
                            button_standard = { position = { 190 0 } size = { 153 34 }
                                text = "[Localize(Select_CString(GetPlayer.MakeScope.Var('ama_acc_second_3').IsSet, GetPlayer.MakeScope.Var('ama_acc_second_3').GetFlagKey, 'ama_acc_second'))]"
                                onclick = "[GetScriptedGui('ama_acc_edit_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('ama_column', MakeScopeValue('(CFixedPoint)8')).End)]"
                                down = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('ama_acc_picker').GetValueWithDefault('(CFixedPoint)0'), '(CFixedPoint)8')]"
                            }
                            text_single = { position = { 352 0 } size = { 152 34 }
                                text = "[Localize(Concatenate('ama_acc_state_', IntToString(FixedPointToInt(GetPlayer.MakeScope.Var('ama_acc_state_3').GetValueWithDefault('(CFixedPoint)0')))))]"
                                align = center|vcenter fontsize = 14 autoresize = no }
                        }

                        widget = { name = "ama_acc_row_4" size = { 504 34 }
