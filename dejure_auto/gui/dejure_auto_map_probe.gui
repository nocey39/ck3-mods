widget = {
    name = "dejure_auto_map_probe_overlay" size = { 100% 100% } layer = middle
    visible = "[And(Not(IsObserver), GetPlayer.MakeScope.Var('dejure_auto_map_probe_open').IsSet)]"
    alwaystransparent = yes
    widget = {
        name = "dejure_auto_map_probe_card" parentanchor = top|right
        position = { -35 145 } size = { 510 390 }
        using = Window_Background using = Window_Decoration
        filter_mouse = all alwaystransparent = no
        text_single = { position = { 24 20 } size = { 426 32 } autoresize = no
            fontsize = 23 text = "dejure_auto_map_probe_title" }
        button_close = { position = { 458 22 } size = { 28 28 } shortcut = "close_window"
            onclick = "[GetScriptedGui('dejure_auto_map_probe_close_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
        text_multi = { position = { 24 65 } size = { 462 72 } autoresize = no max_width = 462 fontsize = 16
            text = "dejure_auto_map_probe_instructions" }
        text_single = { position = { 24 142 } size = { 462 26 } autoresize = no fontsize = 16
            visible = "[IsGameViewOpen('holding_view')]"
            text = "dejure_auto_map_probe_current" }
        text_single = { position = { 24 142 } size = { 462 26 } autoresize = no fontsize = 16
            visible = "[Not(IsGameViewOpen('holding_view'))]"
            text = "dejure_auto_map_probe_no_view" }
        button_standard = { position = { 24 178 } size = { 462 34 }
            text = "dejure_auto_map_probe_record"
            enabled = "[And(IsGameViewOpen('holding_view'), HoldingView.GetCountyTitle.IsValid)]"
            onclick = "[GetScriptedGui('dejure_auto_map_probe_read_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('dejure_auto_map_probe_input', HoldingView.GetCountyTitle.MakeScope).End)]"
        }
        text_single = { position = { 24 226 } size = { 462 24 } autoresize = no fontsize = 16
            text = "dejure_auto_map_probe_records" }
        text_single = { position = { 24 256 } size = { 462 24 } autoresize = no fontsize = 16 elide = right
            visible = "[GetPlayer.MakeScope.Var('dejure_auto_map_probe_county').IsSet]"
            text = "dejure_auto_map_probe_county" }
        text_single = { position = { 24 286 } size = { 462 24 } autoresize = no fontsize = 16 elide = right
            visible = "[GetPlayer.MakeScope.Var('dejure_auto_map_probe_duchy').IsSet]"
            text = "dejure_auto_map_probe_duchy" }
        text_single = { position = { 24 286 } size = { 462 24 } autoresize = no fontsize = 16
            visible = "[And(GetPlayer.MakeScope.Var('dejure_auto_map_probe_county').IsSet, Not(GetPlayer.MakeScope.Var('dejure_auto_map_probe_duchy').IsSet))]"
            text = "dejure_auto_map_probe_no_duchy" }
        button_standard = { position = { 24 334 } size = { 462 32 } text = "dejure_auto_map_probe_back"
            onclick = "[GetScriptedGui('dejure_auto_map_probe_back_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
    }
}
