widget = { name = "dejure_auto_select_probe_overlay" size = { 100% 100% } layer = middle
    alwaystransparent = yes visible = "[And(Not(IsObserver), GetPlayer.IsValid)]"
    widget = { name = "dejure_auto_select_probe_active" size = { 100% 100% } alwaystransparent = yes
        visible = "[GetPlayer.MakeScope.Var('dejure_auto_select_probe_open').IsSet]"
        # Data model supplies Title objects; no HoldingView/ActivityPlanner access.
        flowcontainer = { datacontext = "[GetPlayer]" datamodel = "[Character.GetTitles]"
            size = { 1 1 } alwaystransparent = yes
            item = { widget = { size = { 1 1 } alwaystransparent = yes

                    state = { name = "dejure_auto_select_probe_watch_1"
                        trigger_when = "[And(IsDefaultGUIMode, And(GetPlayer.MakeScope.Var('dejure_auto_select_probe_open').IsSet, And(Title.IsCounty, Title.IsSelected)))]"
                        on_start = "[GetScriptedGui('dejure_auto_select_probe_receive_1_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('dejure_auto_select_probe_county', Title.MakeScope).AddScope('dejure_auto_select_probe_ticket', MakeScopeValue(GetPlayer.MakeScope.Var('dejure_auto_select_probe_epoch').GetValue)).End)]"
                    }

                    state = { name = "dejure_auto_select_probe_watch_2"
                        trigger_when = "[And(IsDefaultGUIMode, And(GetPlayer.MakeScope.Var('dejure_auto_select_probe_open').IsSet, And(Title.IsCounty, Title.GetCountyData.GetCapital.GetHolding.IsSelected)))]"
                        on_start = "[GetScriptedGui('dejure_auto_select_probe_receive_2_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('dejure_auto_select_probe_county', Title.MakeScope).AddScope('dejure_auto_select_probe_ticket', MakeScopeValue(GetPlayer.MakeScope.Var('dejure_auto_select_probe_epoch').GetValue)).AddScope('dejure_auto_select_probe_province', Title.GetCountyData.GetCapital.MakeScope).End)]"
                    }

                    state = { name = "dejure_auto_select_probe_watch_3"
                        trigger_when = "[And(IsDefaultGUIMode, And(GetPlayer.MakeScope.Var('dejure_auto_select_probe_open').IsSet, And(Title.IsBarony, Title.GetProvince.GetHolding.IsSelected)))]"
                        on_start = "[GetScriptedGui('dejure_auto_select_probe_receive_3_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('dejure_auto_select_probe_county', Title.GetProvince.GetCounty.GetTitle.MakeScope).AddScope('dejure_auto_select_probe_ticket', MakeScopeValue(GetPlayer.MakeScope.Var('dejure_auto_select_probe_epoch').GetValue)).AddScope('dejure_auto_select_probe_province', Title.GetProvince.MakeScope).AddScope('dejure_auto_select_probe_barony', Title.MakeScope).End)]"
                    }

                } }
        }
        widget = { parentanchor = top|right position = { -30 160 } size = { 420 320 }
            using = Window_Background using = Window_Decoration alwaystransparent = no filter_mouse = all
            text_single = { position = { 40 20 } size = { 340 28 } autoresize = no align = left|vcenter
                fontsize = 20 text = "dejure_auto_select_probe_title" }
            text_multi = { position = { 40 58 } size = { 340 44 } max_width = 340 autoresize = no align = top|left
                fontsize = 16 text = "dejure_auto_select_probe_instructions" tooltip = "dejure_auto_select_probe_help" }

            text_single = { position = { 40 108 } size = { 340 24 } autoresize = no align = left|vcenter
                fontsize = 16 elide = right visible = "[GetPlayer.MakeScope.Var('dejure_auto_select_probe_last_1').IsSet]" text = "dejure_auto_select_probe_result_1" tooltip = "dejure_auto_select_probe_help" }
            text_single = { position = { 40 108 } size = { 340 24 } autoresize = no align = left|vcenter
                fontsize = 16 elide = right visible = "[Not(GetPlayer.MakeScope.Var('dejure_auto_select_probe_last_1').IsSet)]" text = "dejure_auto_select_probe_waiting_1" }
            text_single = { position = { 40 132 } size = { 340 20 } autoresize = no align = left|vcenter
                fontsize = 14 text = "dejure_auto_select_probe_count_1" }

            text_single = { position = { 40 160 } size = { 340 24 } autoresize = no align = left|vcenter
                fontsize = 16 elide = right visible = "[GetPlayer.MakeScope.Var('dejure_auto_select_probe_last_2').IsSet]" text = "dejure_auto_select_probe_result_2" tooltip = "dejure_auto_select_probe_help" }
            text_single = { position = { 40 160 } size = { 340 24 } autoresize = no align = left|vcenter
                fontsize = 16 elide = right visible = "[Not(GetPlayer.MakeScope.Var('dejure_auto_select_probe_last_2').IsSet)]" text = "dejure_auto_select_probe_waiting_2" }
            text_single = { position = { 40 184 } size = { 340 20 } autoresize = no align = left|vcenter
                fontsize = 14 text = "dejure_auto_select_probe_count_2" }

            text_single = { position = { 40 212 } size = { 340 24 } autoresize = no align = left|vcenter
                fontsize = 16 elide = right visible = "[GetPlayer.MakeScope.Var('dejure_auto_select_probe_last_3').IsSet]" text = "dejure_auto_select_probe_result_3" tooltip = "dejure_auto_select_probe_help" }
            text_single = { position = { 40 212 } size = { 340 24 } autoresize = no align = left|vcenter
                fontsize = 16 elide = right visible = "[Not(GetPlayer.MakeScope.Var('dejure_auto_select_probe_last_3').IsSet)]" text = "dejure_auto_select_probe_waiting_3" }
            text_single = { position = { 40 236 } size = { 340 20 } autoresize = no align = left|vcenter
                fontsize = 14 text = "dejure_auto_select_probe_count_3" }

            button_standard = { position = { 40 270 } size = { 340 30 } text = "dejure_auto_select_probe_done"
                onclick = "[GetScriptedGui('dejure_auto_select_probe_back_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
        }
    }
}
